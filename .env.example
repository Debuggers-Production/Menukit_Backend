# Application
APP_NAME=SmartMenu QR
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:dhanush1511@localhost:5432/menukit

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (console | smtp)
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartmenuqr.com

# Azure Blob Storage (leave empty for local storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=smartmenu-images

# Upload
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5

MINIO_ENDPOINT: str = "play.min.io"
MINIO_ACCESS_KEY: str = "Q3AM3UQ867SPQQA"
MINIO_BUCKET_NAME=smartmenu-images

# Firebase Cloud Messaging (FCM Push Notifications)
# Option 1: File path to Firebase Service Account JSON (relative to Menukit_Backend or absolute)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
# Option 2: Raw JSON string of service account (ideal for Docker / containerized environments)
FIREBASE_CREDENTIALS_JSON=
# Firebase Project ID
FIREBASE_PROJECT_ID=
FCM_ENABLED=true
